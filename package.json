{
  "name": "phpbb-wysiwyg-builder",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild styles/all/template/js/src/tiptap-simple.js --bundle --minify --format=iife --outfile=styles/all/template/js/tiptap-simple.js",
    "lint:js": "eslint styles/all/template/js/src/**/*.js",
    "lint:css": "stylelint \"styles/all/theme/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "stylelint": "^17.14.1",
